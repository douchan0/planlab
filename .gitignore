# raw downloads are cached locally, not committed (manifest + processed are committed)
data/raw/*.jsonstat
data/raw/*.zip
data/raw/*.xlsx
data/raw/*.csv

# large run outputs: keep summaries, drop the per-period dump
results/**/runs.parquet
results/**/runs_*.parquet

